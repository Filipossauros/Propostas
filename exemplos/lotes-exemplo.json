  "descricaoProjeto": "substituir as aplicações de gestão clínica em fim de vida por uma plataforma única e interoperável, assegurando a continuidade do serviço durante a migração",
  "justificacao": {
    "objetivos": [
      {
        "id": "objetivo-1",
        "designacao": "Assegurar a continuidade do desenvolvimento e da manutenção das aplicações de gestão clínica até à sua substituição"
      },
      {
        "id": "objetivo-2",
        "designacao": "Concretizar a migração para uma plataforma única e interoperável, sem interrupção do serviço prestado às instituições"
      },
      {
        "id": "objetivo-3",
        "designacao": "Garantir a interoperabilidade da nova plataforma com os sistemas centrais do SNS"
      }
    ],
    "beneficios": [
      {
        "id": "beneficio-1",
        "designacao": "Redução do tempo de registo clínico, com uma única aplicação em vez de várias por instituição"
      },
      {
        "id": "beneficio-2",
        "designacao": "Partilha de informação clínica entre instituições, sem reintrodução manual de dados"
      },
      {
        "id": "beneficio-3",
        "designacao": "Diminuição dos custos de manutenção associados a aplicações em fim de vida"
      }
    ],
    "riscos": [
      {
        "id": "risco-1",
        "designacao": "Interrupção do suporte às aplicações em fim de vida, com impacto na continuidade da prestação de cuidados"
      },
      {
        "id": "risco-2",
        "designacao": "Exposição a vulnerabilidades de segurança sem correção disponível"
      },
      {
        "id": "risco-3",
        "designacao": "Perda do conhecimento acumulado pelas equipas, por falta de continuidade dos recursos"
      }
    ]
  },
